#
# Script to set the system up for running hammerdb.
#
source ${TOOLS_BIN}/error_codes
source ${TOOLS_BIN}/helpers.inc
disks=none
mountpoint=none
db_type=none
log_mount_point="none"

#
# Detect the distribution we are running on (rhel, ubuntu, sles, ...).  The
# database install routines key off this to pick the right config locations,
# service behaviour and OS specific setup (mandatory access control, datadir
# initialization, socket paths, ...).  Keep new OS handling confined to the
# per-distro case statements so adding a distro or a new database stays
# localized.
#
running_os=$(${TOOLS_BIN}/detect_os)
export running_os

install_mssql()
{
	#
	# Latest version for rhel is 9.0
	#
	arch=$(arch)
	if [[ $arch == "aarch64" ]]; then
		echo Error: mssql has no build for ARM systems..
		exit $E_GENERAL
	fi
	wget https://packages.microsoft.com/config/rhel/9.0/mssql-server-2025.repo
	mv mssql-server-2025.repo /etc/yum.repos.d
	curl https://packages.microsoft.com/config/rhel/9.0/prod.repo | tee /etc/yum.repos.d/mssql-release.repo
	
	dnf clean all
	dnf -y makecache
	dnf -y install mssql-server
	echo done installing mssql-server/mssql-tools
	ACCEPT_EULA=Y yum install -y mssql-tools18 unixODBC-devel msodbcsql18
	echo 'export PATH="$PATH:/opt/mssql-tools18/bin"' >> ~/.bash_profile
	cd $hmd_dir
	cp -R  ${script_dir}/hammerdb_scripts/mssql/* .

	rm -rf ${mountpoint}/mssql_data/*
	mkdir -p ${mountpoint}/mssql_data
	chown -R mssql:mssql ${mountpoint}/mssql_data 
	chown -R mssql:mssql /perf1/mssql_data
	
	systemctl stop mssql-server

	cd /opt/mssql/bin/
	mkdir /var/opt/mssql/secrets/

	MSSQL_SA_PASSWORD="A2!bcdefgh"
	export MSSQL_SA_PASSWORD
	export MSSQL_PID="Evaluation"

	rm -rf /var/opt/mssql
	chmod 777 /var/opt
	#
	# Need to keep everything happy.
	#
	if [[ -d "/opt/mssql-tools" ]]; then
		mv /opt/mssql-tools /opt/mssql-tools_orig
	fi
	ln -s /opt/mssql-tools18 /opt/mssql-tools

	echo 1 > input
	echo Yes >> input
	echo A2!bcdefgh >> input
	echo A2!bcdefgh >> input
	./mssql-conf -n setup accept-eula < input
	rm input

	sleep 30
	systemctl stop mssql-server

	cd /var/opt/mssql
	mv data ${mountpoint}/mssql_data
	ln -sf ${mountpoint}/mssql_data/data .

	systemctl disable mssql-server.service
	systemctl restart mssql-server.service
	sleep 60

	cd $hmd_dir

	./createdb_mssql_mnt.sh -m ${mountpoint} > crdb.out 2>&1

	./update_temp_mnt.sh -m ${mountpoint} > upd_tmp.out 2>&1
}

install_packages()
{
	package_tool --wrapper_config ${run_dir}/${1} --no_packages $to_no_pkg_install
	prtc=$?
	if [[ $prtc -ne 0 ]]; then
		echo Package installation of ${1}, using ${TOOLS_BIN}/package_tool was unsuccessful.
		exit $prtc
	fi
}

install_mariadb()
{
	install_packages hammerdb_mariadb.json
	#
	# Configure things in and mount the appropriate item.
	#
	cd $hmd_dir
	cp -R ${script_dir}/hammerdb_scripts/mariadb/* .

	#
	# Clean up any residual stuff and set up the directories
	#
	rm -rf ${mountpoint}/mysql/* ${log_mount_point}/mysql/log
	mkdir -p ${mountpoint}/mysql/data
	chown -R mysql:mysql ${mountpoint}/mysql
        mkdir -p ${log_mount_point}/mysql/log
        chown -R mysql:mysql ${log_mount_point}/mysql


	totmem=`cat /proc/meminfo | grep "MemTotal:" | awk '{print $2}'`
	#
	# Updating the value of buffer_pool_size based on available memory
	# Setting bufferpool to half of physical memory if memory is less than 128G else set to 64G
	#
	totmem_BP=`expr $totmem / 1024`
	totmem_BP=`expr $totmem_BP / 2`

	#
	# Configure the mariadb config file with mountpoint and bufferpool
	#

	sed -i "s+^datadir=.*+datadir=${mountpoint}\/mysql\/data+" my.cnf
	if [ $totmem_BP -lt 64000 ]; then
   		sed -i "s/^innodb_buffer_pool_size=.*/innodb_buffer_pool_size=${totmem_BP}M/" my.cnf
	else
   		sed -i "s/^innodb_buffer_pool_size=.*/innodb_buffer_pool_size=64000M/" my.cnf
	fi
	sed -i "/innodb_file_per_table/a innodb_log_group_home_dir = ${log_mount_point}\/mysql\/log" my.cnf

	#
	# Place the config where this distribution's MariaDB will read it and
	# perform any OS specific preparation before the first start.
	#
	case $running_os in
		ubuntu|debian)
			#
			# Debian/Ubuntu MariaDB reads /etc/mysql rather than
			# /etc/my.cnf.  Drop our tuning into the conf.d directory
			# that the shipped /etc/mysql/my.cnf already includes.
			#
			mkdir -p /etc/mysql/mariadb.conf.d
			/usr/bin/cp my.cnf /etc/mysql/mariadb.conf.d/99-hammerdb.cnf

			#
			# AppArmor confines mariadbd to /var/lib/mysql.  Our datadir
			# lives on the mounted test volume, so retire the profile the
			# same way SELinux is disabled elsewhere in the kit.  The loaded
			# profile is named "mariadbd" regardless of the file it came
			# from, so unload it by name through the kernel interface -- this
			# does not depend on the on-disk filename, which varies by
			# release.  Then symlink any matching profile file into disable/
			# and reload so the profile stays off across an apparmor
			# reload/reboot.  Cover the modern (mariadbd) and legacy (mysqld)
			# names.
			#
			aa_remove="/sys/kernel/security/apparmor/.remove"
			if [ -w "$aa_remove" ]; then
				for aa_name in mariadbd mysqld; do
					echo -n "$aa_name" > "$aa_remove" 2> /dev/null
				done
			fi
			for aa_file in /etc/apparmor.d/mariadbd \
				       /etc/apparmor.d/usr.sbin.mariadbd \
				       /etc/apparmor.d/mysqld \
				       /etc/apparmor.d/usr.sbin.mysqld; do
				if [ -e "$aa_file" ]; then
					mkdir -p /etc/apparmor.d/disable
					ln -sf "$aa_file" /etc/apparmor.d/disable/
				fi
			done
			systemctl reload apparmor 2> /dev/null

			#
			# Unlike RHEL, the Debian/Ubuntu mariadb.service does not
			# initialize an empty datadir on first start, so seed it here.
			#
			mariadb-install-db --user=mysql --datadir=${mountpoint}/mysql/data > mariadb_install_db.out 2>&1
		;;
		*)
			/usr/bin/cp my.cnf /etc/my.cnf
		;;
	esac

	systemctl restart mariadb.service

    	echo "SET PASSWORD FOR 'root'@localhost = PASSWORD('mysql');" > input
	echo "flush privileges;" >> input
	echo "exit" >> input

	#
	# --skip-ssl: the server runs with ssl=0 (no TLS, to avoid benchmark
	# overhead) but newer clients (e.g. MariaDB 11.x on Ubuntu) default to
	# requiring TLS and otherwise fail with "SSL is required, but the server
	# does not support it".  Harmless on older clients.
	#
	mysql --skip-ssl -u root < input
	rm input
	sleep 30
	systemctl restart mariadb.service
}

install_postgres()
{
	#
	# Installing Postgres Server and tools
	#
	install_packages hammerdb_postgres.json

	cd $hmd_dir
	cp -R ${script_dir}/hammerdb_scripts/postgres/* .

	#
	# Change shared_buffer size based on available memory
	#
	totmem=`cat /proc/meminfo |grep "MemTotal:" | awk '{print $2}'`
	totmem_MB=`expr $totmem / 1024`
	totmem_BP=`expr $totmem_MB / 2`   # Buffer pool is half of physical memory
	#
	# IF total memory is more than 128G then bufferpool is set to 64G else set to half of physical memory
	#
	if [ ${totmem_BP} -lt 64000 ]; then
   		sed -i "s/^shared_buffers =.*/shared_buffers = ${totmem_BP}MB/" postgresql.conf
	else
	   	sed -i "s/^shared_buffers =.*/shared_buffers = 64000MB/" postgresql.conf
	fi

	#
	# Place the datadir on the mounted test volume and the WAL on the log
	# volume.  Both are populated by the per-distro init below.
	#
	pg_datadir=${mountpoint}/postgres_data
	pg_logdir=${log_mount_point}/postgres_log

	rm -rf ${pg_datadir}
	mkdir -p ${pg_datadir}
	chmod 700 ${pg_datadir}
	chown -R postgres:postgres ${pg_datadir}
	mkdir -p ${pg_logdir}
	chown -R postgres:postgres ${pg_logdir}

	#
	# Initialize the cluster and work out where this distribution's PostgreSQL
	# reads its configuration from.  The init command, config location and
	# service behaviour differ per OS, so keep each distro's handling confined
	# to the case below.  pg_conf_dir is where pg_hba.conf lives; the tuning in
	# postgresql.conf is applied differently (see further down) because on
	# Debian/Ubuntu the packaged postgresql.conf owns the path settings and must
	# not be overwritten.
	#
	case $running_os in
		ubuntu|debian)
			#
			# Installing the postgresql package auto-creates a "main"
			# cluster under /var/lib/postgresql/<ver> with its config in
			# /etc/postgresql/<ver>/main.  Drop it and recreate the
			# cluster with its datadir on the mounted test volume.
			#
			pg_ver=$(pg_lsclusters -h | awk '{print $1}' | head -1)
			pg_conf_dir=/etc/postgresql/${pg_ver}/main

			#
			# postgresql.conf pins lc_* to en_GB.UTF-8, which is not
			# generated on a stock Ubuntu image.  Without it the cluster
			# refuses to start (and psql later reports "connection
			# refused"), so generate it before the cluster is created.
			#
			locale-gen en_GB.UTF-8

			pg_dropcluster --stop ${pg_ver} main
			pg_createcluster --datadir=${pg_datadir} ${pg_ver} main > pg_createcluster.out 2>&1
		;;
		*)
			#
			# RHEL stores the datadir and config at a fixed location;
			# symlink it onto the mounted test volume and initialize it in
			# place.  pg_hba.conf and postgresql.conf both live in the
			# datadir.
			#
			pg_conf_dir=${pg_datadir}
			rm -rf /var/lib/pgsql/data
			ln -sf ${pg_datadir} /var/lib/pgsql/data
			postgresql-setup initdb
			sleep 10
		;;
	esac

	#
	# Relocate the WAL onto the log volume.  The server is stopped at this
	# point (initdb/pg_createcluster do not start it).
	#
	mv ${pg_datadir}/pg_wal ${pg_logdir}
	ln -sf ${pg_logdir}/pg_wal ${pg_datadir}/pg_wal

	#
	# Install the trust-auth pg_hba.conf so the benchmark's local and TCP
	# connections are accepted without a password prompt, and apply our tuning.
	#
	/usr/bin/cp -f pg_hba.conf ${pg_conf_dir}/pg_hba.conf
	case $running_os in
		ubuntu|debian)
			#
			# The packaged postgresql.conf sets data_directory, hba_file
			# and the socket paths, so leave it alone and drop our tuning
			# into the conf.d include directory it already reads.
			#
			mkdir -p ${pg_conf_dir}/conf.d
			/usr/bin/cp -f postgresql.conf ${pg_conf_dir}/conf.d/99-hammerdb.conf
		;;
		*)
			/usr/bin/cp -f postgresql.conf ${pg_conf_dir}/postgresql.conf
		;;
	esac

	systemctl restart postgresql
	echo "alter role postgres password 'postgres'" > input

	psql -U postgres -d postgres < input
	rm input
	sleep 30
	systemctl restart postgresql.service
}

usage()
{
  echo "Usage:
        ./install-script [-h] [-d disk name] [-m mount point] [-t dbtype] [-u path]

        Usage:
        -h help
        -d <disk device name>
        -m <mount point>
	-t <mariadb, mssql, postgres>
	-u <path> Kit location


       Examples:
        ./install-script -d '/dev/sdb' 
        ./install-script -d '/perf1' 
  "
  exit $E_USAGE
}

#
# If we did not pass any arguments, flag it.
#
if [ $# -eq 0 ]; then
    usage;
fi

while [ $# -gt 0 ]
do
	case $1 in
        	-h)
			usage;
		;;
        	-d)
			disks=$2
			shift 2
		;;
		-M)
			log_mount_point=$2
			shift 2
		;;
		-m)
			mountpoint=$2
			shift 2
		;;
		-t) 
			db_type=$2
			shift 2
		;;
		*)
			usage;
		;;
	esac
done

if [[ $db_type == "none" ]]; then
	echo You need to designate the db type.
	usage
fi

#
# Turn selinux off (setenforce only exists on SELinux based distros such as
# RHEL; on Ubuntu/others AppArmor is handled per-database instead).
#
command -v setenforce > /dev/null 2>&1 && setenforce 0

#
# Install the hammerdb
#
mkdir -p $hmd_dir
pushd  $hmd_dir > /dev/null
#
# HammerDB 6.0 is shipped as a tarball rather than a self-extracting installer.
# Pick the RHEL9 tarball matching the host architecture.  We currently use RHEL 9 as
# there is no RHEL 10 download.
#
case `uname -m` in
	aarch64|arm64)
		hammerdb_tarball="HammerDB-${hammerdb_version}-Prod-Lin-RHEL9-ARM64.tar.gz"
	;;
	*)
		hammerdb_tarball="HammerDB-${hammerdb_version}-Prod-Lin-RHEL9.tar.gz"
	;;
esac
echo install ${hammerdb_tarball}
wget https://github.com/TPC-Council/HammerDB/releases/download/v${hammerdb_version}/${hammerdb_tarball}
if [[ $? -ne 0 ]]; then
	echo Error: Failed to download ${hammerdb_tarball}
	exit 1
fi
#
# The tarball extracts into a HammerDB-<version> directory.  Strip that top
# level directory so the hammerdbcli launcher lands directly in $hmd_dir.
#
tar --strip-components=1 -xzf ${hammerdb_tarball}
if [[ $? -ne 0 ]]; then
	echo Error: Failed to extract ${hammerdb_tarball}
	exit 1
fi
rm -f ${hammerdb_tarball}
echo ${hammerdb_tarball} installed.

#
# Shutdown all running instances
#
systemctl stop mssql-server
systemctl stop postgresql
systemctl stop mariadb

#
# Create filestems and mount if required
#
if [[ $mountpoint == *"none"* ]]; then
	echo "using disk option"
	umount /perf1
	mkfs.xfs -f ${disks}
	mkdir -p /perf1
	mount ${disks} /perf1
	mountpoint="/perf1"
else
	echo "using mountpoint option"
	echo ${mountpoint}
fi

if [[ $log_mount_point == "none" ]]; then
	log_mount_point=${mountpoint}
fi
if [[ $db_type == "mssql" ]]; then
	install_mssql
elif [[ $db_type == "mariadb" ]]; then
	install_mariadb
elif [[ $db_type == "postgres" ]]; then
	install_postgres
else
	echo $db_type is not known, bailing.
	exit $E_GENERAL
fi
exit $E_SUCCESS
